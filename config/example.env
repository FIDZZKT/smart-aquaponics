# ============================================
# Smart Aquaponics Dashboard - Configuration
# ============================================
# 
# CATATAN: File ini adalah CONTOH konfigurasi
# Untuk penggunaan, salin file ini dan rename menjadi .env
# 
# ⚠️ JANGAN commit file .env yang berisi token asli!
# ============================================

# Blynk Configuration
# Dapatkan token dari Blynk Console → Device Info
BLYNK_AUTH_TOKEN=your_blynk_auth_token_here

# Blynk Server (optional - default: blynk.cloud)
BLYNK_SERVER=blynk.cloud

# Virtual Pin Mapping
# Sesuaikan dengan konfigurasi ESP32 Anda
VPIN_TEMPERATURE=V0
VPIN_AIR_HUMIDITY=V5
VPIN_SOIL_MOISTURE=V1
VPIN_SOIL_STATUS=V2
VPIN_FEED_CONTROL=V3

# Polling Configuration
# Interval pengambilan data dalam milliseconds
POLL_INTERVAL=2000

# Threshold Settings
# Temperature (Celsius)
TEMP_MIN=15
TEMP_MAX=35
TEMP_CRITICAL_MAX=40

# Air Humidity (Percentage)
HUMIDITY_MIN=30
HUMIDITY_MAX=80
HUMIDITY_CRITICAL_MIN=20

# Soil Moisture (Percentage)
SOIL_MIN=20
SOIL_MAX=80
SOIL_CRITICAL_MIN=10

# Feed Control
FEED_PULSE_DURATION=1500

# API Configuration
API_TIMEOUT=5000
RECONNECT_DELAY=3000

# ============================================
# Cara Penggunaan:
# ============================================
# 
# 1. Copy file ini:
#    cp config/example.env .env
# 
# 2. Edit .env dan isi dengan token asli Anda
# 
# 3. Dashboard akan otomatis membaca dari localStorage
#    (File ini hanya untuk referensi struktur)
# 
# ============================================
